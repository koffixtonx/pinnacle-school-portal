# Supabase project credentials (Dashboard -> Project Settings -> API Keys)
# Both values are public by design: access is governed by Postgres Row Level Security.
# VITE_SUPABASE_ANON_KEY takes either key format the dashboard offers - the newer
# "sb_publishable_..." key, or a legacy anon JWT starting with "eyJ". Never put a
# secret key ("sb_secret_...") or the service_role key here: this file is inlined
# into the browser bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional error reporting (Sentry -> Project Settings -> Client DSN).
# Leave it unset and the app reports nothing anywhere. The DSN is a write-only
# ingest key: it can send events but cannot read them back, so it is safe to
# inline. It still decides where crash data goes, so prefer the host's
# environment UI over committing it to a public repository.
#VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
